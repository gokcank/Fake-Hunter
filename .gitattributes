* text=auto

# Shell and Gradle wrapper scripts must keep LF line endings for Android /system/bin/sh & Linux
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Source and configuration files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.jks binary
*.keystore binary
