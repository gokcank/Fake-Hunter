    <string name="issue_title_ram_spoofed">RAM Boyutu Sahte</string>
    <string name="issue_desc_ram_spoofed">Android toplam %1$s MB RAM bildiriyor ancak çekirdek fiziksel belleği yalnızca %2$s MB.</string>
    <string name="issue_title_virtual_ram">Sanal RAM / ZRAM Genişletmesi Etkin</string>
    <string name="issue_desc_virtual_ram" formatted="false">Yüksek sıkıştırılmış ZRAM takas alanı (%1$s MB; %3$s MB fiziksel RAM\'in %%%2$s kadarı) Android 11+ cihazlarda yaygındır. Satıcı iddiasını fiziksel RAM ile karşılaştırın.</string>
    <string name="issue_title_high_swap">Yüksek Takas Belleği Ayırma</string>
    <string name="issue_desc_high_swap" formatted="false">Takas belleği (%1$s MB), fiziksel RAM\'in (%3$s MB) %%%2$s kadarıdır. Ucuz teypler yüksek RAM göstermek için takas alanını fiziksel RAM ile birleştirir.</string>
    <string name="issue_title_disk_swap">Yüksek Disk Tabanlı Takas Alanı</string>
    <string name="issue_desc_disk_swap" formatted="false">Disk tabanlı takas alanı fiziksel RAM\'in %%%1$s kadarıdır (%2$s MB / %3$s MB).</string>
    <string name="issue_title_cpu_restricted">İşlemci Frekansları Kısıtlı</string>
    <string name="issue_desc_cpu_restricted">Sistem güvenlik kısıtlamaları çekirdek frekanslarının okunmasını engelledi; bildirilen %1$s çekirdek saat hızıyla doğrulanamadı.</string>
    <string name="issue_title_fake_cores">Sahte İşlemci Çekirdeği Tespit Edildi</string>
    <string name="issue_desc_fake_cores">Sistem %1$s çekirdek bildiriyor ancak yalnızca %2$s çekirdek aktif çalışma frekansı üretiyor.</string>
    <string name="issue_title_storage_spoofed">Depolama Boyutu Sahte</string>
    <string name="issue_desc_storage_spoofed">/data bölümü %1$s MB bildiriyor ancak dahili fiziksel bellek yongaları yalnızca %2$s MB kapasiteye sahip.</string>
    <string name="issue_title_ac8227l">AC8227L Yonga Seti İmzası</string>
    <string name="issue_desc_ac8227l_fake">AutoChips/MediaTek AC8227L (32-bit 4 çekirdekli Cortex-A7) yongası, bildirilen özelliklerle (çekirdek, RAM veya Android sürümü) çelişiyor.</string>
    <string name="issue_desc_ac8227l_info">Eski nesil 4 çekirdekli AutoChips/MediaTek AC8227L platformu saptandı. Satıcının 8 çekirdek veya Android 11+ vaat etmediğini doğrulayın.</string>
    <string name="issue_title_allwinner_t3">Allwinner T3 / sun8i Yonga İmzası</string>
    <string name="issue_desc_allwinner_t3_fake">Allwinner sun8i/T3 (32-bit 4 çekirdekli Cortex-A7) yongası, bildirilen özelliklerle (çekirdek, RAM veya Android sürümü) çelişiyor.</string>
    <string name="issue_desc_allwinner_t3_info">Eski nesil 4 çekirdekli Allwinner sun8i/T3 platformu saptandı. Satıcının 8 çekirdek veya Android 11+ vaat etmediğini doğrulayın.</string>
    <string name="issue_title_mt6580">MT6580 Eski Yonga İmzası</string>
    <string name="issue_desc_mt6580_fake">MediaTek MT6580 (2015 32-bit 4 çekirdekli işlemci) bildirilen özelliklerle (çekirdek, RAM veya Android sürümü) çelişiyor.</string>
    <string name="issue_desc_mt6580_info">Eski nesil 4 çekirdekli MediaTek MT6580 platformu saptandı. Güncel 8 çekirdekli donanım olarak satılmadığından emin olun.</string>
    <string name="issue_title_rockchip">Rockchip Giriş Seviyesi Yonga İmzası</string>
    <string name="issue_desc_rockchip_fake">Giriş seviyesi 4 çekirdekli Rockchip RK3128/RK3228/RK3229 yongası bildirilen özelliklerle çelişiyor.</string>
    <string name="issue_desc_rockchip_info">Giriş seviyesi 4 çekirdekli Rockchip platformu saptandı; sıklıkla şişirilmiş özelliklerle yeniden satılır.</string>
    <string name="issue_title_android_spoofed">Android Sürümü Sahte</string>
    <string name="issue_desc_android_spoofed">Bildirilen Android %1$s sürümü, gerçek çekirdek API seviyesi %2$s (Android %3$s) ile çelişiyor.</string>
