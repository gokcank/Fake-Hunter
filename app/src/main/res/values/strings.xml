    <string name="issue_desc_ac8227l_fake">AutoChips/MediaTek AC8227L (32-bit Quad-Core Cortex-A7) contradicts the reported specs (cores, RAM, or Android version).</string>
    <string name="issue_desc_ac8227l_info">Legacy AutoChips/MediaTek AC8227L Quad-Core platform identified. Verify seller claims do not advertise 8-core or Android 11+.</string>
    <string name="issue_title_allwinner_t3">Allwinner T3 / sun8i Signature</string>
    <string name="issue_desc_allwinner_t3_fake">Allwinner sun8i/T3 (32-bit Quad-Core Cortex-A7) contradicts the reported specs (cores, RAM, or Android version).</string>
    <string name="issue_desc_allwinner_t3_info">Legacy Allwinner sun8i/T3 Quad-Core platform identified. Verify seller claims do not advertise 8-core or Android 11+.</string>
    <string name="issue_title_mt6580">MT6580 Legacy Chipset Signature</string>
    <string name="issue_desc_mt6580_fake">MediaTek MT6580 (2015 32-bit Quad-Core CPU) contradicts the reported specs (cores, RAM, or Android version).</string>
    <string name="issue_desc_mt6580_info">Legacy MediaTek MT6580 Quad-Core platform identified. Verify seller claims do not advertise modern 8-core hardware.</string>
    <string name="issue_title_rockchip">Rockchip Legacy Signature</string>
    <string name="issue_desc_rockchip_fake">Entry-level Rockchip RK3128/RK3228/RK3229 Quad-Core chipset contradicts the reported specs.</string>
    <string name="issue_desc_rockchip_info">Entry-level Rockchip Quad-Core platform identified. Frequently resold with inflated specifications.</string>
