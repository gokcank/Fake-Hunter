    <string name="issue_title_ram_spoofed">RAM Size Spoofed</string>
    <string name="issue_desc_ram_spoofed">Android reports %1$s MB total RAM, but Linux kernel physical RAM is only %2$s MB.</string>
    <string name="issue_title_virtual_ram">Virtual RAM / ZRAM Expansion Active</string>
    <string name="issue_desc_virtual_ram" formatted="false">Large compressed ZRAM swap (%1$s MB, %2$s%% of %3$s MB physical RAM) is common on Android 11+ devices. Verify seller claims against physical RAM.</string>
    <string name="issue_title_high_swap">High Swap Allocation</string>
    <string name="issue_desc_high_swap" formatted="false">Swap memory (%1$s MB) is %2$s%% of physical RAM (%3$s MB). Budget head units often combine swap with physical RAM to advertise inflated RAM.</string>
    <string name="issue_title_disk_swap">Elevated Disk Swap Allocation</string>
    <string name="issue_desc_disk_swap" formatted="false">Disk-backed swap space is %1$s%% of physical RAM (%2$s MB vs %3$s MB).</string>
    <string name="issue_title_cpu_restricted">CPU Frequencies Restricted</string>
    <string name="issue_desc_cpu_restricted">System security restrictions prevented reading core clock frequencies; reported %1$s cores could not be verified by active frequency.</string>
    <string name="issue_title_fake_cores">Fake CPU Cores Detected</string>
    <string name="issue_desc_fake_cores">System reports %1$s CPU cores, but only %2$s generate active clock frequency.</string>
    <string name="issue_title_storage_spoofed">Storage Size Spoofed</string>
    <string name="issue_desc_storage_spoofed">The /data partition reports %1$s MB, but the internal physical flash chip(s) only hold %2$s MB.</string>
