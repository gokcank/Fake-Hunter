<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FakeHunter" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorSecondary">@color/primary_accent</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="alertDialogTheme">@style/Theme.FakeHunter.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.FakeHunter.Dialog</item>
    </style>

    <style name="Theme.FakeHunter.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/card_dark</item>
        <item name="android:background">@color/card_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Theme.FakeHunter.Dialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.FakeHunter.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.FakeHunter.DialogButton</item>
    </style>

    <style name="Theme.FakeHunter.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FakeHunter.DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/primary_accent</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
